<Project>
  <!--
    Канон agent semver: agent/VERSION (не корневой/server VERSION).
    CI может переопределить через -p:Version= (release-msi input/tag).
  -->
  <PropertyGroup>
    <_AgentVersionFile>$(MSBuildThisFileDirectory)VERSION</_AgentVersionFile>
    <Version Condition="Exists('$(_AgentVersionFile)') and '$(Version)' == ''">$([System.IO.File]::ReadAllText('$(_AgentVersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">1.3.1</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
