<Project>
  <!--
    Канон agent semver: agent/VERSION (не корневой/server VERSION).
    CI может переопределить через -p:Version= (release-msi input/tag).
  -->
  <PropertyGroup>
    <_AgentVersionFile>$(MSBuildThisFileDirectory)VERSION</_AgentVersionFile>
    <Version Condition="Exists('$(_AgentVersionFile)') and '$(Version)' == ''">$([System.IO.File]::ReadAllText('$(_AgentVersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">1.3.1</Version>
    <!-- AssemblyVersion и FileVersion только числа. Суффикс вроде -beta остаётся в InformationalVersion. -->
    <_VersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[-+].*$', ''))</_VersionCore>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(_VersionCore).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(_VersionCore).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
