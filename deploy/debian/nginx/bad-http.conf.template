# Сайт nginx bAD — HTTP only (пока TLS cert не загружен из UI)
limit_req_zone $binary_remote_addr zone=bad_enroll:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=bad_api:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __BAD_DOMAIN__;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    client_max_body_size 5m;

    location /v1/enroll {
        limit_req zone=bad_enroll burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=bad_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
