# Сайт nginx bAD — TLS termination, proxy на uvicorn 127.0.0.1:8000
limit_req_zone $binary_remote_addr zone=bad_enroll:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=bad_api:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __BAD_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __BAD_DOMAIN__;

    ssl_certificate     __BAD_TLS_CERT__;
    ssl_certificate_key __BAD_TLS_KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:BAD_SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    client_max_body_size 5m;

    location /v1/enroll {
        limit_req zone=bad_enroll burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=bad_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
