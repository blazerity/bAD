<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI Windows-агента bAD (WiX v4/v5).
  Сборка на Windows после publish агента:

    dotnet publish ..\..\agent\src\BadAgent\BadAgent.csproj -c Release -r win-x64 -p:SelfContained=true -o .\publish
    Copy-Item .\write-config.ps1 .\publish\
    Copy-Item .\cleanup-uninstall.ps1 .\publish\
    Copy-Item .\bad-paths.ps1 .\publish\
    Copy-Item .\bad.cmd .\publish\
    wix extension add (флаг global) WixToolset.Util.wixext/5.0.2
    wix build Product.wxs -ext WixToolset.Util.wixext -arch x64 -d AgentPublishDir=publish -d ProductVersion=0.11.0 -o bad-agent-0.11.0.msi

  Публичные свойства (msiexec):
    SERVERURL=https://bad.example.com
    ENROLLMENTTOKEN=<site enrollment token>
    ADDPATH=1   (опционально; по умолчанию 0 / отсутствует = не менять PATH)
                При 1: добавить INSTALLFOLDER в Machine PATH, чтобы `bad` (shim bad.cmd) работал из cmd.exe / Win+R.

  SEC-011: ENROLLMENTTOKEN / SERVERURL пишутся в HKLM\SOFTWARE\blazerity\bAD\Setup через RegistryValue
  (не в argv deferred PowerShell). write-config.ps1 читает Setup и сразу удаляет ключ.

  Upgrade сохраняет %ProgramData%\blazerity\bAD\ (API key / device_id) — Permanent CreateFolder.
  Полный uninstall: ServiceControl Stop+Remove; Program Files; cleanup-uninstall.ps1 чистит
  config.json / queue / logs (enrollment leftovers). Permanent dir сам по себе не мешает очистке файлов.
  ServiceControl останавливает BlazerityAssetDiscovery перед заменой файлов и запускает после установки.

  Диагностика CA: коды BAD_MSI_### в %ProgramData%\blazerity\bAD\logs\msi-install.log
  и в msiexec-логе (MsiLogging=voicewarmupx → %TEMP%\MSI*.log; WixQuietExec пишет stderr).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "0.10.1" ?>
  <?endif?>

  <Package
      Name="blazerity Asset Discovery Agent"
      Manufacturer="blazerity"
      Version="$(ProductVersion)"
      UpgradeCode="BADA0001-BADA-4B01-8BAD-00BADA000001"
      Scope="perMachine">

    <!-- AllowDowngrades: политика pin может откатить агент на более старый MSI (0.10). -->
    <MajorUpgrade
        AllowDowngrades="yes"
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Метка семейства в Add/Remove Programs + меню Пуск (та же, что ApplicationIcon / favicon). -->
    <Icon Id="BadAgentIcon" SourceFile="bad.ico" />
    <Property Id="ARPPRODUCTICON" Value="BadAgentIcon" />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />
    <!-- Опциональный PATH: по умолчанию отсутствует/0 = не менять Machine PATH. Передать ADDPATH=1 для включения. -->
    <Property Id="ADDPATH" Secure="yes" Value="0" />

    <!-- Автолог msiexec в %TEMP%\MSI*.log (voicewarmupx), даже без /l*v. -->
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <!-- 1722 = «программа из состава установки завершилась неожиданно» (RU dialog). -->
    <Error Id="1722"
           Message="bAD Agent Setup failed (MSI 1722 / custom action). Look for BAD_MSI_### in %ProgramData%\blazerity\bAD\logs\msi-install.log and %TEMP%\MSI*.log. Action [2], location: [3], command: [4]" />
    <Error Id="25001"
           Message="bAD MSI BAD_MSI_001: bad-paths.ps1 missing next to write-config.ps1. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
    <Error Id="25002"
           Message="bAD MSI BAD_MSI_002: cannot create ProgramData directories. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
    <Error Id="25003"
           Message="bAD MSI BAD_MSI_003: cannot write config.json. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
    <Error Id="25004"
           Message="bAD MSI BAD_MSI_004: cannot set config.json ACL. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
    <Error Id="25005"
           Message="bAD MSI BAD_MSI_005: unexpected write-config failure. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />

    <Feature Id="Main" Title="bAD Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ProgramDataDir" />
      <ComponentRef Id="WriteConfig" />
      <ComponentRef Id="AddPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BlazerityDir" Name="blazerity">
        <Directory Id="INSTALLFOLDER" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BlazerityDataDir" Name="blazerity">
        <Directory Id="BADDATA" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <!-- Harvest publish/** кроме BadAgent.exe (он в AgentService = KeyPath службы). -->
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AgentPublishDir)\**">
        <Exclude Files="$(AgentPublishDir)\BadAgent.exe" />
      </Files>
    </ComponentGroup>

    <!-- Permanent: MajorUpgrade не сносит ProgramData (device_id/api_key). Полный uninstall чистит файлы CA. -->
    <Component Id="ProgramDataDir" Directory="BADDATA" Guid="BADA0003-BADA-4B01-8BAD-00BADA000003" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
      </CreateFolder>
    </Component>

    <!-- ServiceInstall требует KeyPath = service exe (не RegistryValue). -->
    <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="BADA0004-BADA-4B01-8BAD-00BADA000004">
      <File Id="BadAgentExe" Source="$(AgentPublishDir)\BadAgent.exe" KeyPath="yes" />
      <ServiceInstall
          Id="BadServiceInstall"
          Name="BlazerityAssetDiscovery"
          DisplayName="blazerity Asset Discovery"
          Description="Collects hardware/OS inventory and reports to the bAD server."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />
      <ServiceControl
          Id="BadServiceControl"
          Name="BlazerityAssetDiscovery"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]" />
    </Component>

    <!-- WriteConfig: маркер + временный HKLM Setup; write-config.ps1 читает и удаляет. -->
    <Component Id="WriteConfig" Directory="BADDATA" Guid="BADA0005-BADA-4B01-8BAD-00BADA000005">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="Configured"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="ServerUrl"
          Type="string"
          Value="[SERVERURL]" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="EnrollmentToken"
          Type="string"
          Value="[ENROLLMENTTOKEN]" />
    </Component>

    <!--
      Опциональный Machine PATH: только при msiexec … ADDPATH=1.
      Добавляет INSTALLFOLDER, чтобы bad.cmd (shim → BadAgent.exe) находился как `bad`.
      Permanent="no" убирает запись PATH при uninstall.
    -->
    <Component Id="AddPath" Directory="INSTALLFOLDER" Guid="BADA0006-BADA-4B01-8BAD-00BADA000006" Condition="ADDPATH=&quot;1&quot;">
      <Environment
          Id="BadPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="AddPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!--
      WixQuietExec: Id свойства = Id CA; command + stdout/stderr попадают в MSI-лог.
      Id совпадает с CustomAction, чтобы CustomActionData передался в deferred.
    -->
    <SetProperty Id="WriteConfigAction"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]write-config.ps1&quot;"
                 Sequence="execute"
                 Before="WriteConfigAction" />

    <CustomAction
        Id="WriteConfigAction"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <!-- Полный uninstall: очистить config/queue/logs. Не на MajorUpgrade. -->
    <SetProperty Id="CleanupUninstallAction"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]cleanup-uninstall.ps1&quot;"
                 Sequence="execute"
                 Before="CleanupUninstallAction" />

    <CustomAction
        Id="CleanupUninstallAction"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <!-- После WriteRegistryValues, чтобы Setup\EnrollmentToken уже был в HKLM. -->
      <Custom Action="WriteConfigAction" After="WriteRegistryValues" Condition="NOT REMOVE" />
      <!-- После StopServices / до RemoveFiles, пока cleanup-uninstall.ps1 ещё на диске. -->
      <Custom Action="CleanupUninstallAction" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
