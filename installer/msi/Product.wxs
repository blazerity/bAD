<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI Windows-агента bAD (WiX v4/v5).
  Сборка на Windows после publish агента:

    dotnet publish ..\..\agent\src\BadAgent\BadAgent.csproj -c Release -r win-x64 --self-contained true -o .\publish
    Copy-Item .\write-config.ps1 .\publish\
    Copy-Item .\cleanup-uninstall.ps1 .\publish\
    Copy-Item .\bad-paths.ps1 .\publish\
    Copy-Item .\bad.cmd .\publish\
    wix build Product.wxs -d AgentPublishDir=publish -d ProductVersion=0.9.1 -o bad-agent-0.9.1.msi

  Публичные свойства (msiexec):
    SERVERURL=https://bad.example.com
    ENROLLMENTTOKEN=<site enrollment token>
    ADDPATH=1   (опционально; по умолчанию 0 / отсутствует = не менять PATH)
                При 1: добавить INSTALLFOLDER в Machine PATH, чтобы `bad` (shim bad.cmd) работал из cmd.exe / Win+R.

  SEC-011: ENROLLMENTTOKEN / SERVERURL пишутся в HKLM\SOFTWARE\blazerity\bAD\Setup через RegistryValue
  (не в argv deferred PowerShell). write-config.ps1 читает Setup и сразу удаляет ключ.

  Upgrade сохраняет %ProgramData%\blazerity\bAD\ (API key / device_id) — Permanent CreateFolder.
  Полный uninstall: ServiceControl Stop+Remove; Program Files; cleanup-uninstall.ps1 чистит
  config.json / queue / logs (enrollment leftovers). Permanent dir сам по себе не мешает очистке файлов.
  ServiceControl останавливает BlazerityAssetDiscovery перед заменой файлов и запускает после установки.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "0.9.1" ?>
  <?endif?>

  <Package
      Name="blazerity Asset Discovery Agent"
      Manufacturer="blazerity"
      Version="$(ProductVersion)"
      UpgradeCode="BADA0001-BADA-4B01-8BAD-BLAZERITY0BAD"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of bAD is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Метка семейства в Add/Remove Programs + меню Пуск (та же, что ApplicationIcon / favicon). -->
    <Icon Id="BadAgentIcon" SourceFile="bad.ico" />
    <Property Id="ARPPRODUCTICON" Value="BadAgentIcon" />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />
    <!-- Опциональный PATH: по умолчанию отсутствует/0 = не менять Machine PATH. Передать ADDPATH=1 для включения. -->
    <Property Id="ADDPATH" Secure="yes" Value="0" />

    <Feature Id="Main" Title="bAD Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ProgramDataDir" />
      <ComponentRef Id="WriteConfig" />
      <ComponentRef Id="AddPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BlazerityDir" Name="blazerity">
        <Directory Id="INSTALLFOLDER" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BlazerityDataDir" Name="blazerity">
        <Directory Id="BADDATA" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <!-- Собрать все publish-артефакты (exe + deps + write-config/cleanup/bad-paths.ps1 + bad.cmd). -->
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AgentPublishDir)\**" />
    </ComponentGroup>

    <!-- Permanent: MajorUpgrade не сносит ProgramData (device_id/api_key). Полный uninstall чистит файлы CA. -->
    <Component Id="ProgramDataDir" Directory="BADDATA" Guid="BADA0003-BADA-4B01-8BAD-BLAZERITY0BAD" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
      </CreateFolder>
    </Component>

    <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="BADA0004-BADA-4B01-8BAD-BLAZERITY0BAD">
      <ServiceInstall
          Id="BadServiceInstall"
          Name="BlazerityAssetDiscovery"
          DisplayName="blazerity Asset Discovery"
          Description="Collects hardware/OS inventory and reports to the bAD server."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />
      <ServiceControl
          Id="BadServiceControl"
          Name="BlazerityAssetDiscovery"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
    </Component>

    <!--
      WriteConfig: маркер + временный Setup (SERVERURL / ENROLLMENTTOKEN) через RegistryValue.
      Не передаём token в argv PowerShell (SEC-011). write-config.ps1 удаляет Setup после чтения.
    -->
    <Component Id="WriteConfig" Directory="BADDATA" Guid="BADA0005-BADA-4B01-8BAD-BLAZERITY0BAD">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="Configured"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="ServerUrl"
          Type="string"
          Value="[SERVERURL]" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="EnrollmentToken"
          Type="string"
          Value="[ENROLLMENTTOKEN]" />
    </Component>

    <!--
      Опциональный Machine PATH: только при msiexec … ADDPATH=1.
      Добавляет INSTALLFOLDER, чтобы bad.cmd (shim → BadAgent.exe) находился как `bad`.
      Permanent="no" убирает запись PATH при uninstall.
    -->
    <Component Id="AddPath" Directory="INSTALLFOLDER" Guid="BADA0006-BADA-4B01-8BAD-BLAZERITY0BAD" Condition="ADDPATH=&quot;1&quot;">
      <Environment
          Id="BadPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="AddPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- Без SERVERURL/ENROLLMENTTOKEN в командной строке — только путь к скрипту. -->
    <SetProperty Id="WriteConfigCmd"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]write-config.ps1&quot;"
                 Sequence="execute"
                 Before="WriteConfigAction" />

    <CustomAction
        Id="WriteConfigAction"
        Directory="INSTALLFOLDER"
        ExeCommand="[WriteConfigCmd]"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <!-- Полный uninstall: очистить config/queue/logs. Не на MajorUpgrade. -->
    <SetProperty Id="CleanupUninstallCmd"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]cleanup-uninstall.ps1&quot;"
                 Sequence="execute"
                 Before="CleanupUninstallAction" />

    <CustomAction
        Id="CleanupUninstallAction"
        Directory="INSTALLFOLDER"
        ExeCommand="[CleanupUninstallCmd]"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <!-- После WriteRegistryValues, чтобы Setup\EnrollmentToken уже был в HKLM. -->
      <Custom Action="WriteConfigAction" After="WriteRegistryValues">NOT REMOVE</Custom>
      <!-- После StopServices / до RemoveFiles, пока cleanup-uninstall.ps1 ещё на диске. -->
      <Custom Action="CleanupUninstallAction" Before="RemoveFiles">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Package>
</Wix>
