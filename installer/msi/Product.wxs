<?xml version="1.0" encoding="UTF-8"?>
<!--
  bADagent Link. ProductVersion всегда 1.0.0, не agent/VERSION.
  Диалог — LinkUi.wxs. Служба: installer\link\bADagent.exe.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "1.0.0" ?>
  <?endif?>

  <Package
      Name="bADagent Link"
      Manufacturer="blazerity"
      Version="$(ProductVersion)"
      UpgradeCode="BADA0001-BADA-4B01-8BAD-00BADA000001"
      Codepage="1251"
      Scope="perMachine">

    <MajorUpgrade
        AllowDowngrades="yes"
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BadAgentIcon" SourceFile="bad.ico" />
    <Property Id="ARPPRODUCTICON" Value="BadAgentIcon" />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="ADDPATH" Secure="yes" Value="1" />
    <Property Id="REBOOT" Value="ReallySuppress" />

    <UIRef Id="LinkUi" />

    <Feature Id="Main" Title="bADagent" Level="1">
      <ComponentRef Id="BadCmdShim" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ProgramDataDir" />
      <ComponentRef Id="AddPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BlazerityDir" Name="blazerity">
        <Directory Id="INSTALLFOLDER" Name="bADagent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BlazerityDataDir" Name="blazerity">
        <Directory Id="BADDATA" Name="bADagent" />
      </Directory>
    </StandardDirectory>

    <Component Id="BadCmdShim" Directory="INSTALLFOLDER" Guid="BADA0008-BADA-4B01-8BAD-00BADA000008">
      <File Id="BadExe" Source="..\link\bad.exe" KeyPath="yes" />
    </Component>

    <Component Id="ProgramDataDir" Directory="BADDATA" Guid="BADA0003-BADA-4B01-8BAD-00BADA000003" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
      </CreateFolder>
    </Component>

    <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="BADA0004-BADA-4B01-8BAD-00BADA000004">
      <File Id="LinkExe" Source="..\link\bADagent.exe" KeyPath="yes" />
      <ServiceInstall
          Id="BadServiceInstall"
          Name="bADagent"
          DisplayName="bADagent"
          Description="Собирает сведения об оборудовании и ОС и отправляет их на сервер bAD."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />
      <ServiceControl
          Id="BadServiceControl"
          Name="bADagent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bADagent"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bADagent\Setup"
          Name="ServerUrl"
          Type="string"
          Value="[SERVERURL]" />
    </Component>

    <Component Id="AddPath" Directory="INSTALLFOLDER" Guid="BADA0006-BADA-4B01-8BAD-00BADA000006" Condition="ADDPATH=&quot;1&quot;">
      <Environment
          Id="BadPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bADagent"
          Name="AddPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
