<?xml version="1.0" encoding="UTF-8"?>
<!--
  bAD Windows agent MSI (WiX v4/v5).
  Build on Windows after publishing the agent:

    dotnet publish ..\..\agent\src\BadAgent\BadAgent.csproj -c Release -r win-x64 --self-contained true -o .\publish
    Copy-Item .\write-config.ps1 .\publish\
    Copy-Item .\bad.cmd .\publish\
    wix build Product.wxs -d AgentPublishDir=publish -d ProductVersion=0.7.0 -o bad-agent-0.7.0.msi

  Public properties (msiexec):
    SERVERURL=https://bad.example.com
    ENROLLMENTTOKEN=<site enrollment token>
    ADDPATH=1   (optional; default 0 / absent = do not modify PATH)
                When 1: append INSTALLFOLDER to Machine PATH so `bad` (bad.cmd shim) works from cmd.exe / Win+R.

  Upgrade preserves %ProgramData%\blazerity\bAD\ (API key / device_id).
  ServiceControl stops BlazerityAssetDiscovery before replacing files and starts it after install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "0.7.0" ?>
  <?endif?>

  <Package
      Name="blazerity Asset Discovery Agent"
      Manufacturer="blazerity"
      Version="$(ProductVersion)"
      UpgradeCode="BADA0001-BADA-4B01-8BAD-BLAZERITY0BAD"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of bAD is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs + Start menu family mark (same as ApplicationIcon / favicon). -->
    <Icon Id="BadAgentIcon" SourceFile="bad.ico" />
    <Property Id="ARPPRODUCTICON" Value="BadAgentIcon" />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />
    <!-- Optional PATH: default absent/0 = do not modify Machine PATH. Pass ADDPATH=1 to enable. -->
    <Property Id="ADDPATH" Secure="yes" Value="0" />

    <Feature Id="Main" Title="bAD Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ProgramDataDir" />
      <ComponentRef Id="WriteConfig" />
      <ComponentRef Id="AddPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BlazerityDir" Name="blazerity">
        <Directory Id="INSTALLFOLDER" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BlazerityDataDir" Name="blazerity">
        <Directory Id="BADDATA" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <!-- Harvest all published artifacts (exe + deps + write-config.ps1 + bad.cmd). -->
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AgentPublishDir)\**" />
    </ComponentGroup>

    <Component Id="ProgramDataDir" Directory="BADDATA" Guid="BADA0003-BADA-4B01-8BAD-BLAZERITY0BAD" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
      </CreateFolder>
    </Component>

    <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="BADA0004-BADA-4B01-8BAD-BLAZERITY0BAD">
      <ServiceInstall
          Id="BadServiceInstall"
          Name="BlazerityAssetDiscovery"
          DisplayName="blazerity Asset Discovery"
          Description="Collects hardware/OS inventory and reports to the bAD server."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />
      <ServiceControl
          Id="BadServiceControl"
          Name="BlazerityAssetDiscovery"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
    </Component>

    <!-- Custom action writes ProgramData config from public properties without embedding secrets in MSI binary -->
    <Component Id="WriteConfig" Directory="BADDATA" Guid="BADA0005-BADA-4B01-8BAD-BLAZERITY0BAD">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="Configured"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!--
      Optional Machine PATH: only when msiexec … ADDPATH=1.
      Appends INSTALLFOLDER so bad.cmd (shim → BadAgent.exe) is found as `bad`.
      Permanent="no" removes the PATH entry on uninstall.
    -->
    <Component Id="AddPath" Directory="INSTALLFOLDER" Guid="BADA0006-BADA-4B01-8BAD-BLAZERITY0BAD" Condition="ADDPATH=&quot;1&quot;">
      <Environment
          Id="BadPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="AddPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <SetProperty Id="WriteConfigCmd"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]write-config.ps1&quot; -ServerUrl &quot;[SERVERURL]&quot; -EnrollmentToken &quot;[ENROLLMENTTOKEN]&quot;"
                 Sequence="execute"
                 Before="WriteConfigAction" />

    <CustomAction
        Id="WriteConfigAction"
        Directory="INSTALLFOLDER"
        ExeCommand="[WriteConfigCmd]"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="WriteConfigAction" After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Package>
</Wix>
