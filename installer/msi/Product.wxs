<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI bAD 2.x: %ProgramFiles%\blazerity\bad agent\ (bin\ + ms\ + lib\, scripts\, bad.cmd).
  Framework-dependent: на ПК нужен .NET 8 Runtime x64.
  ProgramData: %ProgramData%\blazerity\bAD\ — Permanent, без переименования.
  UpgradeCode BADA0001…; MajorUpgrade AllowDowngrades; migrate-legacy-install.ps1.
  Апгрейд: msiexec /i новый.msi /qn (не /upgrade).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "2.0.0" ?>
  <?endif?>

  <Package
      Name="blazerity Asset Discovery Agent"
      Manufacturer="blazerity"
      Version="$(ProductVersion)"
      UpgradeCode="BADA0001-BADA-4B01-8BAD-00BADA000001"
      Codepage="1251"
      Scope="perMachine">

    <MajorUpgrade
        AllowDowngrades="yes"
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BadAgentIcon" SourceFile="bad.ico" />
    <Property Id="ARPPRODUCTICON" Value="BadAgentIcon" />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />
    <Property Id="ADDPATH" Secure="yes" Value="1" />
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <UI>
      <Error Id="1722"
             Message="bAD Agent Setup failed (MSI 1722 / custom action). Look for BAD_MSI_### in %ProgramData%\blazerity\bAD\logs\msi-install.log and %TEMP%\MSI*.log. Action [2], location: [3], command: [4]" />
      <Error Id="25001"
             Message="bAD MSI BAD_MSI_001: bad-paths.ps1 missing next to write-config.ps1. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
      <Error Id="25002"
             Message="bAD MSI BAD_MSI_002: cannot create ProgramData directories. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
      <Error Id="25003"
             Message="bAD MSI BAD_MSI_003: cannot write config.json. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
      <Error Id="25004"
             Message="bAD MSI BAD_MSI_004: cannot set config.json ACL. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
      <Error Id="25005"
             Message="bAD MSI BAD_MSI_005: unexpected write-config failure. See %ProgramData%\blazerity\bAD\logs\msi-install.log" />
    </UI>

    <Feature Id="Main" Title="bAD Agent" Level="1">
      <ComponentGroupRef Id="AgentBinFiles" />
      <ComponentRef Id="AgentScriptFiles" />
      <ComponentRef Id="BadCmdShim" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ProgramDataDir" />
      <ComponentRef Id="WriteConfig" />
      <ComponentRef Id="AddPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="BlazerityDir" Name="blazerity">
        <Directory Id="INSTALLFOLDER" Name="bad agent">
          <Directory Id="BIN" Name="bin" />
          <Directory Id="SCRIPTS" Name="scripts" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BlazerityDataDir" Name="blazerity">
        <Directory Id="BADDATA" Name="bAD" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentBinFiles" Directory="BIN">
      <Files Include="$(AgentPublishDir)\bin\**">
        <Exclude Files="$(AgentPublishDir)\bin\BadAgent.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="AgentScriptFiles" Directory="SCRIPTS" Guid="BADA0007-BADA-4B01-8BAD-00BADA000007">
      <File Id="BadPathsPs1" Source="$(AgentPublishDir)\scripts\bad-paths.ps1" KeyPath="yes" />
      <File Id="WriteConfigPs1" Source="$(AgentPublishDir)\scripts\write-config.ps1" />
      <File Id="CleanupUninstallPs1" Source="$(AgentPublishDir)\scripts\cleanup-uninstall.ps1" />
      <File Id="MigrateLegacyPs1" Source="$(AgentPublishDir)\scripts\migrate-legacy-install.ps1" />
    </Component>

    <Component Id="BadCmdShim" Directory="INSTALLFOLDER" Guid="BADA0008-BADA-4B01-8BAD-00BADA000008">
      <File Id="BadCmd" Source="$(AgentPublishDir)\bad.cmd" KeyPath="yes" />
    </Component>

    <Component Id="ProgramDataDir" Directory="BADDATA" Guid="BADA0003-BADA-4B01-8BAD-00BADA000003" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)" />
      </CreateFolder>
    </Component>

    <Component Id="AgentService" Directory="BIN" Guid="BADA0004-BADA-4B01-8BAD-00BADA000004">
      <File Id="BadAgentExe" Source="$(AgentPublishDir)\bin\BadAgent.exe" KeyPath="yes" />
      <ServiceInstall
          Id="BadServiceInstall"
          Name="badagent"
          DisplayName="bAD Agent"
          Description="Собирает сведения об оборудовании и ОС и отправляет их на сервер bAD."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Account="LocalSystem"
          Vital="yes" />
      <ServiceControl
          Id="BadServiceControl"
          Name="badagent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]" />
    </Component>

    <Component Id="WriteConfig" Directory="BADDATA" Guid="BADA0005-BADA-4B01-8BAD-00BADA000005">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="Configured"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="ServerUrl"
          Type="string"
          Value="[SERVERURL]" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD\Setup"
          Name="EnrollmentToken"
          Type="string"
          Value="[ENROLLMENTTOKEN]" />
    </Component>

    <Component Id="AddPath" Directory="INSTALLFOLDER" Guid="BADA0006-BADA-4B01-8BAD-00BADA000006" Condition="ADDPATH=&quot;1&quot;">
      <Environment
          Id="BadPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\blazerity\bAD"
          Name="AddPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <SetProperty Id="MigrateLegacyAction"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\migrate-legacy-install.ps1&quot;"
                 Sequence="execute"
                 Before="MigrateLegacyAction" />

    <CustomAction
        Id="MigrateLegacyAction"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <SetProperty Id="WriteConfigAction"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\write-config.ps1&quot;"
                 Sequence="execute"
                 Before="WriteConfigAction" />

    <CustomAction
        Id="WriteConfigAction"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <SetProperty Id="CleanupUninstallAction"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\cleanup-uninstall.ps1&quot;"
                 Sequence="execute"
                 Before="CleanupUninstallAction" />

    <CustomAction
        Id="CleanupUninstallAction"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <!-- Скрипты уже на диске; migrate — до InstallServices (служба badagent). -->
      <Custom Action="MigrateLegacyAction" Before="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="WriteConfigAction" After="MigrateLegacyAction" Condition="NOT REMOVE" />
      <Custom Action="CleanupUninstallAction" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
